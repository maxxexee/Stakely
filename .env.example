[TEMPLATE]
# API service (copy to api/.env)
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TxLINE oracle. Set TXLINE_USE_MOCK=false once a token is active.
TXLINE_API_TOKEN=txoracle_api_your-token
TXLINE_API_ORIGIN=https://txline-dev.txodds.com
TXLINE_NETWORK=devnet
TXLINE_USE_MOCK=true

# Solana and escrow
SOLANA_RPC_URL=https://api.devnet.solana.com
ESCROW_PROGRAM_ID=J2zMD6jRMFetFr82nqk1jBsmdSYSuDKKsbfnJRqHRcai

# Server-only secret used by the keeper settlement callback
KEEPER_API_SECRET=replace-with-a-long-random-value

# Optional: enables AI predictions
ANTHROPIC_API_KEY=

PORT=4000

# Web service (copy to web/.env)
VITE_API_URL=https://stakely-production.up.railway.app
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_ESCROW_PROGRAM_ID=J2zMD6jRMFetFr82nqk1jBsmdSYSuDKKsbfnJRqHRcai
VITE_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Notes
# The service role key and keeper secret belong on the server only.
# The VITE_ values are compiled into the browser bundle and must stay public.
